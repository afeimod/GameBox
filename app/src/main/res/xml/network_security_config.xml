<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许所有域名明文（http）流量：许多 Flash 游戏站仅支持 http -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
